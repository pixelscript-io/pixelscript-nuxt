{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "deploy": "nuxt build && wrangler deploy",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxtjs/tailwindcss": "^6.12.1",
    "motion-v": "^2.2.1",
    "nuxt": "^3.21.0",
    "nuxt-gtag": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^18",
    "@vitest/coverage-v8": "^1.1.0",
    "@vue/test-utils": "^2.4.3",
    "jsdom": "^23.0.1",
    "typescript": "^5.3.3",
    "vue-tsc": "^2.0.0",
    "wrangler": "^4.151.1",
    "vitest": "^1.1.0"
  }
}
